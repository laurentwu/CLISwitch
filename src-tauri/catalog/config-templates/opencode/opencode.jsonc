// Configuration: ~/.config/opencode/opencode.jsonc
// Credentials: ~/.local/share/opencode/auth.json; use the same provider ID in both files.
// Merge entries into existing files to preserve other providers and their credentials.
{
  "$schema": "https://opencode.ai/config.json",
  "model": "<provider-id>/<model-id>",
  "provider": {
    "<provider-id>": {
      "npm": "<npm-package>",
      "name": "<provider-name>",
      "options": {
        "baseURL": "<base-url>"
      },
      "models": {
        "<model-id>": {
          "name": "<model-name>",
          "reasoning": true
        }
      }
    }
  }
}
